# Porta da API e do PDV Web
PORT=3000

# Modo Híbrido (se rodar no PC do cliente: aponte VPS_URL para o IP/domínio da Google VPS; na própria VPS deixe vazio)
VPS_URL=
VPS_TIMEOUT_MS=2500

# PIN de Administrador para definir/travar o setor da loja
ADMIN_PIN=2026

# Setor inicial na subida (pizzaria, piercing, acougue, rotisseria, barbearia, petshop, tintas, japones, bebidas, autopecas)
SETOR_INICIAL=pizzaria
NOME_LOJA=Pizzaria Forno Nobre
CIDADE_LOJA=Centro
DONO_WHATSAPP=5511999999999

# Provedor de IA: gemini (recomendado custo/velocidade) ou openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=COLE_SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Conexão Evolution API (WhatsApp na VPS)
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=omnicommerce_secret_key_2026
EVOLUTION_INSTANCE=loja_principal
